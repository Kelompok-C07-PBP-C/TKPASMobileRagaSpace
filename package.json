{
  "name": "marco-js-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:js": "jest --coverage --coverageReporters=text --coverageReporters=lcov"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/backend/app/static/app/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/backend/app/static/app/__tests__/jest.setup.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "backend/app/static/app/admin.js",
      "backend/app/static/app/admin_auth.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  }
}
